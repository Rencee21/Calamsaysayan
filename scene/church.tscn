[node name="Label" type="Label" parent="father"]
z_index = 2
y_sort_enabled = true
offset_left = -33.0
offset_top = -271.0
offset_right = 630.0
offset_bottom = -95.0
scale = Vector2(0.953042, 1.15384)
theme_override_fonts/font = ExtResource("11_630f6")
theme_override_font_sizes/font_size = 25
text = "Welcome, child, to St. John the Baptist Parish Church here in Calamba. You stand within walls 
that have borne witness to centuries of faith, hardship, renewal, and the shaping of a people."
visible_characters = 0
visible_ratio = 0.0
metadata/_edit_lock_ = true

[node name="Label2" type="Label" parent="father"]
z_index = 2
y_sort_enabled = true
offset_left = -33.0
offset_top = -271.0
offset_right = 631.0
offset_bottom = -95.0
scale = Vector2(0.953042, 1.15384)
theme_override_fonts/font = ExtResource("11_630f6")
theme_override_font_sizes/font_size = 25
text = "I see you’ve come with a sincere heart. Let me tell you our story, so that you understand why 
this place is more than stone and wood."
visible_characters = 0
visible_ratio = 0.0
metadata/_edit_lock_ = true

[node name="Label3" type="Label" parent="father"]
z_index = 2
y_sort_enabled = true
offset_left = -33.0
offset_top = -271.0
offset_right = 631.0
offset_bottom = -95.0
scale = Vector2(0.953042, 1.15384)
theme_override_fonts/font = ExtResource("11_630f6")
theme_override_font_sizes/font_size = 25
text = "This parish was formally established in 1779, when Calamba became independent from 
the parochial church of Cabuyao. The Jesuit missionaries had earlier acquired land here, 
called Hacienda de San Juan, for missions. "
visible_characters = 0
visible_ratio = 0.0
metadata/_edit_lock_ = true

[node name="Label4" type="Label" parent="father"]
z_index = 2
y_sort_enabled = true
offset_left = -33.0
offset_top = -271.0
offset_right = 631.0
offset_bottom = -95.0
scale = Vector2(0.953042, 1.15384)
theme_override_fonts/font = ExtResource("11_630f6")
theme_override_font_sizes/font_size = 25
text = "In 1859, a stone church was constructed in the Baroque style. But during World War II, in 1945, 
this structure was destroyed. The altar had already been burned in 1862, 
but was immediately rebuilt at that time. "
visible_characters = 0
visible_ratio = 0.0
metadata/_edit_lock_ = true

[node name="Label5" type="Label" parent="father"]
z_index = 2
y_sort_enabled = true
offset_left = -33.0
offset_top = -271.0
offset_right = 631.0
offset_bottom = -95.0
scale = Vector2(0.953042, 1.15384)
theme_override_fonts/font = ExtResource("11_630f6")
theme_override_font_sizes/font_size = 25
text = "After the war, restoration was led by Father Eliseo Dimaculangan. Also, young José Rizal, 
our national hero, was baptized here on June 22, 1861, by Fr. Rufino Collantes; 
his godfather was Fr. Pedro Casanas. "
visible_characters = 0
visible_ratio = 0.0
metadata/_edit_lock_ = true

[node name="Label6" type="Label" parent="father"]
z_index = 2
y_sort_enabled = true
offset_left = -33.0
offset_top = -271.0
offset_right = 631.0
offset_bottom = -95.0
scale = Vector2(0.953042, 1.15384)
theme_override_fonts/font = ExtResource("11_630f6")
theme_override_font_sizes/font_size = 25
text = "The baptistery, where that sacred act took place, is recognized as a National Historical Landmark. 
Though many original records were lost—canonical books burned in 1862, much of the original 
altar destroyed—they were restored or replaced where possible."
visible_characters = 0
visible_ratio = 0.0
metadata/_edit_lock_ = true

[node name="Label7" type="Label" parent="father"]
z_index = 2
y_sort_enabled = true
offset_left = -33.0
offset_top = -271.0
offset_right = 631.0
offset_bottom = -95.0
scale = Vector2(0.953042, 1.15384)
theme_override_fonts/font = ExtResource("11_630f6")
theme_override_font_sizes/font_size = 25
text = "Inside these walls one still sees stained‐glass windows depicting saints, the seven sacraments, 
and at the entrance two stained glasses: Saint Dominic and San Lorenzo Ruiz. There was also a 
garden called the Garden of Gethsemane, with the Stations of the Cross and a 
“Well of Repentance” (Balon ng Pagbabalik Loob). Some of its structures have been altered 
in recent years. "
visible_characters = 0
visible_ratio = 0.0
metadata/_edit_lock_ = true

[node name="Label8" type="Label" parent="father"]
z_index = 2
y_sort_enabled = true
offset_left = -33.0
offset_top = -271.0
offset_right = 631.0
offset_bottom = -95.0
scale = Vector2(0.953042, 1.15384)
theme_override_fonts/font = ExtResource("11_630f6")
theme_override_font_sizes/font_size = 25
text = "All this history testifies to our faith—and reminds us of our roots, our struggles, and our 
hope that endures."
visible_characters = 0
visible_ratio = 0.0
metadata/_edit_lock_ = true

[node name="Label9" type="Label" parent="father"]
z_index = 2
y_sort_enabled = true
offset_left = -33.0
offset_top = -271.0
offset_right = 631.0
offset_bottom = -95.0
scale = Vector2(0.953042, 1.15384)
theme_override_fonts/font = ExtResource("11_630f6")
theme_override_font_sizes/font_size = 25
text = "To honor this heritage, I entrust you with a quest. Seek the Master Registry of Baptisms, an old 
record book containing baptisms held here, including that of José Rizal. This object preserves 
not only names, but the very memory of lives consecrated in faith. Only with that record restored 
can the legacy continue."
visible_characters = 0
visible_ratio = 0.0
metadata/_edit_lock_ = true

